<div class="alert alert-danger" id="worldlineonlinecheckout-error-message"
    style="display:none;"></div>
<fieldset>
  <legend>{{ text_payment_info }}</legend>
  <div id="payment-worldlineonlinecheckout-transaction">
</fieldset>

<script type="text/javascript">
    function getTransactionInformation() {
        $('#worldlineonlinecheckout-error-message').click(function (e) {
            $('#worldlineonlinecheckout-error-message').fadeOut('slow');
        });
        $.ajax({
            url: '{{ worldline_ajax_endpoint }}.getPaymentTransaction&user_token={{ user_token }}',
            dataType: 'html',
            data: {
                order_id: '{{ order_id }}'
            },
            beforeSend: function () {
                $('#payment-worldlineonlinecheckout-transaction').html('<i class="worldlineonlinecheckout-loading fa fa-spinner fa-spin fa-5x" style="text-align: center; margin: 0 auto; width: 100%; font-size: 5em;"></i>');
            },
            success: function (html) {
                $('#payment-worldlineonlinecheckout-transaction').html(html);
            }
        });
    }

    getTransactionInformation();
</script>
